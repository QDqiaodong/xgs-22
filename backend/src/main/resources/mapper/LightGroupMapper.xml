<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lightmanager.mapper.LightGroupMapper">

    <resultMap id="LightGroupResultMap" type="com.example.lightmanager.entity.LightGroup">
        <id property="id" column="id"/>
        <result property="groupCode" column="group_code"/>
        <result property="power" column="power"/>
        <result property="zoneId" column="zone_id"/>
        <result property="zoneName" column="zone_name"/>
        <result property="installationLocation" column="installation_location"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectWithZoneNamePage" resultMap="LightGroupResultMap">
        SELECT lg.*, gz.zone_name
        FROM light_group lg
        LEFT JOIN garage_zone gz ON lg.zone_id = gz.id
        WHERE 1=1
        <if test="zoneId != null">AND lg.zone_id = #{zoneId}</if>
        <if test="groupCode != null and groupCode != ''">AND lg.group_code LIKE CONCAT('%', #{groupCode}, '%')</if>
        <if test="status != null">AND lg.status = #{status}</if>
        ORDER BY lg.created_at DESC
    </select>

    <select id="selectByIds" resultMap="LightGroupResultMap">
        SELECT lg.*, gz.zone_name
        FROM light_group lg
        LEFT JOIN garage_zone gz ON lg.zone_id = gz.id
        WHERE lg.id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <update id="batchUpdateZoneId">
        UPDATE light_group SET zone_id = #{zoneId}
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="selectByZoneId" resultMap="LightGroupResultMap">
        SELECT lg.*, gz.zone_name
        FROM light_group lg
        LEFT JOIN garage_zone gz ON lg.zone_id = gz.id
        WHERE lg.zone_id = #{zoneId}
        ORDER BY lg.group_code
    </select>
</mapper>