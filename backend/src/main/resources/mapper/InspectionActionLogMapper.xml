<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lightmanager.mapper.InspectionActionLogMapper">

    <select id="selectByAnomalyId" resultType="com.example.lightmanager.entity.InspectionActionLog">
        SELECT * FROM inspection_action_log
        WHERE anomaly_id = #{anomalyId}
        ORDER BY operated_at ASC, id ASC
    </select>
</mapper>
