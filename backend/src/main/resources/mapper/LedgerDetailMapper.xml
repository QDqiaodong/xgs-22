<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lightmanager.mapper.LedgerDetailMapper">
    
    <insert id="batchInsert">
        INSERT INTO ledger_detail (ledger_id, light_group_id, source_zone_id, target_zone_id)
        VALUES
        <foreach collection="details" item="detail" separator=",">
            (#{detail.ledgerId}, #{detail.lightGroupId}, #{detail.sourceZoneId}, #{detail.targetZoneId})
        </foreach>
    </insert>
    
    <select id="selectByLedgerId" resultType="com.example.lightmanager.entity.LedgerDetail">
        SELECT * FROM ledger_detail WHERE ledger_id = #{ledgerId}
    </select>
</mapper>