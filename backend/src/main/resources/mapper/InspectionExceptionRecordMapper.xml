<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lightmanager.mapper.InspectionExceptionRecordMapper">

    <select id="selectByExceptionId" resultType="com.example.lightmanager.entity.InspectionExceptionRecord">
        SELECT * FROM inspection_exception_record
        WHERE exception_id = #{exceptionId}
        ORDER BY operated_at ASC, id ASC
    </select>
</mapper>
